<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="penta_test_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics settings -->
    <!-- physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>300</iters>
          <sor>1.3</sor>
          <friction_model>pyramid_model</friction_model>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics -->
    
    <physics name="bullet_physics" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <bullet>
        <solver_type>sequential_impulse</solver_type>
        <num_solver_iterations>100</num_solver_iterations>
        <contact_surface_layer>0.001</contact_surface_layer>
        <split_impulse>true</split_impulse>
        <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
      </bullet>
    </physics>

  </world>
</sdf>
