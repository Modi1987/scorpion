{
	"name": "scorpion_devcontainer",
	"dockerComposeFile": "./docker-compose.yaml",
	"service": "scorpion-ros2",    // Specify the primary service name here
	"workspaceFolder": "/root/ros_ws/src",
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM": "1",
	},
	"remoteEnv": {
		// "GITLAB_TOKEN": "${env:GITLAB_TOKEN}"
	},
	"mounts": [
		{
			"source": "/tmp/.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		}
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"llvm-vs-code-extensions.vscode-clangd",
				"eamodio.gitlens",
				"twxs.cmake",
				"ms-vscode.cpptools",
				"mhutchie.git-graph",
				"donjayamanne.githistory",
				"ms-python.black-formatter",
				"redhat.vscode-yaml",
				"GitLab.gitlab-workflow"
			],
			"settings": {
				"C_Cpp.clang_format_path": "clang-format-15",
			}
		}
	}
}
