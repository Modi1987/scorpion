<?xml version="1.0"?>

<robot name="penta_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name_space" default="" />
  <xacro:arg name="use_gazebo_simulation" default="False" />
  <xacro:arg name="use_pca9685_ros2_control" default="False" />
  
  <xacro:property name="PI" value="3.141592" />
  <xacro:property name="PI2" value="${PI/2}" />
  <xacro:property name="base_visual_yaw" value="0.32" />

  <xacro:include filename="$(find penta_description)/urdf/single_limb.urdf.xacro" />

  <xacro:macro name="add_material_green">
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
  </xacro:macro>

  <xacro:macro name="add_material_red">
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find penta_description)/meshes/visual/penta_stl_v1/Chassi_middle.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${base_visual_yaw}"/>
      <xacro:add_material_red/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.085"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="joint_robot_body_center" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <xacro:add_material_green/>
    </visual>
  </link>

  <joint name="head_base" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="-0.1 0.0 0.025" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="add_base_plate" params="name_space name stl_file_name z">
    <link name="${name_space}${name}_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find penta_description)/meshes/visual/penta_stl_v1/${stl_file_name}" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${base_visual_yaw}"/>
        <xacro:add_material_red/>
      </visual>
    </link>
    <joint name="${name_space}${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name_space}${name}_link"/>
    <origin xyz="0.0 0.0 ${z}" rpy="0 0 0"/>
  </joint>
  </xacro:macro>
    

<xacro:add_leg name_space="$(arg name_space)" prefix="limb0" shoulderxyz="${0.085*cos(0.*3.141592/2.5)} ${0.085*sin(0.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(0.*3.141592/2.5)}" use_gazebo_simulation="$(arg use_gazebo_simulation)"/>
<xacro:add_leg name_space="$(arg name_space)" prefix="limb1" shoulderxyz="${0.085*cos(1.*3.141592/2.5)} ${0.085*sin(1.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(1.*3.141592/2.5)}" use_gazebo_simulation="$(arg use_gazebo_simulation)"/>
<xacro:add_leg name_space="$(arg name_space)" prefix="limb2" shoulderxyz="${0.085*cos(2.*3.141592/2.5)} ${0.085*sin(2.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(2.*3.141592/2.5)}" use_gazebo_simulation="$(arg use_gazebo_simulation)"/>
<xacro:add_leg name_space="$(arg name_space)" prefix="limb3" shoulderxyz="${0.085*cos(3.*3.141592/2.5)} ${0.085*sin(3.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(3.*3.141592/2.5)}" use_gazebo_simulation="$(arg use_gazebo_simulation)"/>
<xacro:add_leg name_space="$(arg name_space)" prefix="limb4" shoulderxyz="${0.085*cos(4.*3.141592/2.5)} ${0.085*sin(4.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(4.*3.141592/2.5)}" use_gazebo_simulation="$(arg use_gazebo_simulation)"/>

<xacro:add_base_plate name_space="$(arg name_space)" name="upper_plate" stl_file_name="Chassi_top.stl" z="0.03"/>
<xacro:add_base_plate name_space="$(arg name_space)" name="lower_plate" stl_file_name="Chassi_bottom.stl" z="-0.03"/>

<xacro:if value="$(arg use_gazebo_simulation)">
<gazebo>
  <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control" >
    <parameters>$(find penta_description)/config/ros2_control_params.yaml</parameters>
  </plugin>
  <xacro:include filename="$(find penta_description)/ros2_control/gazebo.ros2_control.xacro" />
</gazebo>
</xacro:if>

<xacro:if value="$(arg use_pca9685_ros2_control)">
  <xacro:include filename="$(find penta_description)/ros2_control/pca9685.ros2_control.xacro" />
  <xacro:add_pca9685_hw_interface name="pca9685" prefix="$(arg name_space)" use_mock_hardware="false"/>
</xacro:if>

</robot>
