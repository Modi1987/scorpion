<?xml version="1.0"?>

<robot name="penta_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:property name="PI" value="3.141592" />
  <xacro:property name="PI2" value="${PI/2}" />
  <xacro:property name="base_visual_yaw" value="0.32" />

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/Chassi_middle.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${base_visual_yaw}"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.085"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="joint_robot_body_center" type="floating">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="head_base" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="-0.1 0.0 0.025" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="add_base_plate" params="name stl_file_name z">
    <link name="${name}_link">
      <visual>
        <geometry>
          <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/${stl_file_name}" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${base_visual_yaw}"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
    <origin xyz="0.0 0.0 ${z}" rpy="0 0 0"/>
  </joint>
  </xacro:macro>
    
  <xacro:macro name="add_leg" params="prefix shoulderxyz shoulderrpy">
    <link name="${prefix}_shoulder_motor">
      <visual>
        <geometry>
          <cylinder radius="0.0350" length="0.035"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      </visual>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <mass value="1.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
      </inertial>
    </link>

    <link name="${prefix}_shoulder_link">
      <visual>
        <geometry>
          <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/Shoulder.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="-${PI2} 0 0"/>
      </visual>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <mass value="1.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
      </inertial>
    </link>

    <link name="${prefix}_upper_arm_link">
      <visual>
        <geometry>
          <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/Upper_arm.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      </visual>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <mass value="1.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
      </inertial>
    </link>

    <link name="${prefix}_lower_arm_link">
      <visual>
        <geometry>
          <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/Lower_arm.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="-${PI2} ${PI2} 0.4"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://penta_description/meshes/visual/penta_stl_v1/Lower_arm.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="-${PI2} ${PI2} 0.4"/>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <mass value="1.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
      </inertial>
    </link>

    <joint name="${prefix}/joint_shoulder_motor" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_shoulder_motor"/>
      <origin xyz="${shoulderxyz}" rpy="${shoulderrpy}"/>
    </joint>


    <joint name="${prefix}/joint0" type="continuous">
      <parent link="${prefix}_shoulder_motor"/>
      <child link="${prefix}_shoulder_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
    </joint>

    <joint name="${prefix}/joint1" type="continuous">
      <parent link="${prefix}_shoulder_link"/>
      <child link="${prefix}_upper_arm_link"/>
      <origin xyz="0.0455 0.0 0.0" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1" />
    </joint>


    <joint name="${prefix}/joint2" type="continuous">
      <parent link="${prefix}_upper_arm_link"/>
      <child link="${prefix}_lower_arm_link"/>
      <origin xyz="0.096 0.0 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
    </joint>

  </xacro:macro>

<xacro:add_leg prefix="limb0" shoulderxyz="${0.085*cos(0.*3.141592/2.5)} ${0.085*sin(0.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(0.*3.141592/2.5)}"/>
<xacro:add_leg prefix="limb1" shoulderxyz="${0.085*cos(1.*3.141592/2.5)} ${0.085*sin(1.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(1.*3.141592/2.5)}"/>
<xacro:add_leg prefix="limb2" shoulderxyz="${0.085*cos(2.*3.141592/2.5)} ${0.085*sin(2.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(2.*3.141592/2.5)}"/>
<xacro:add_leg prefix="limb3" shoulderxyz="${0.085*cos(3.*3.141592/2.5)} ${0.085*sin(3.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(3.*3.141592/2.5)}"/>
<xacro:add_leg prefix="limb4" shoulderxyz="${0.085*cos(4.*3.141592/2.5)} ${0.085*sin(4.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(4.*3.141592/2.5)}"/>

<xacro:add_base_plate name="upper_plate" stl_file_name="Chassi_top.stl" z="0.03"/>
<xacro:add_base_plate name="lower_plate" stl_file_name="Chassi_bottom.stl" z="-0.03"/>

</robot>
