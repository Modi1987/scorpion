<?xml version="1.0"?>

<robot name="penta_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.085" length="0.025"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="joint_robot_body_center" type="floating">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="head_base" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="-0.1 0.0 0.025" rpy="0 0 0"/>
  </joint>
    
  <xacro:macro name="leg" params="prefix shoulderxyz shoulderrpy">
    <link name="${prefix}_shoulder_motor">
      <visual>
        <geometry>
          <cylinder radius="0.0350" length="0.035"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      </visual>
    </link>

    <link name="${prefix}_shoulder_link">
      <visual>
        <geometry>
          <box size="0.0455 0.02 0.02"/>
        </geometry>
        <origin xyz="0.02275 0.0 0.0" rpy="0 0 0"/>
      </visual>
    </link>

    <link name="${prefix}_upper_arm_link">
      <visual>
        <geometry>
          <box size="0.096 0.02 0.02"/>
        </geometry>
        <origin xyz="0.048 0.0 0.0" rpy="0 0 0"/>
      </visual>
    </link>

    <link name="${prefix}_lower_arm_link">
      <visual>
        <geometry>
          <box size="0.158 0.02 0.02"/>
        </geometry>
        <origin xyz="0.079 0.0 0.0" rpy="0 0 0"/>
      </visual>
    </link>

    <joint name="${prefix}/joint_shoulder_motor" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_shoulder_motor"/>
      <origin xyz="${shoulderxyz}" rpy="${shoulderrpy}"/>
    </joint>


    <joint name="${prefix}/joint0" type="continuous">
      <parent link="${prefix}_shoulder_motor"/>
      <child link="${prefix}_shoulder_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
    </joint>

    <joint name="${prefix}/joint1" type="continuous">
      <parent link="${prefix}_shoulder_link"/>
      <child link="${prefix}_upper_arm_link"/>
      <origin xyz="0.0455 0.0 0.0" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1" />
    </joint>


    <joint name="${prefix}/joint2" type="continuous">
      <parent link="${prefix}_upper_arm_link"/>
      <child link="${prefix}_lower_arm_link"/>
      <origin xyz="0.096 0.0 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
    </joint>

  </xacro:macro>

<xacro:leg prefix="limb0" shoulderxyz="${0.085*cos(0.*3.141592/2.5)} ${0.085*sin(0.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(0.*3.141592/2.5)}"/>
<xacro:leg prefix="limb1" shoulderxyz="${0.085*cos(1.*3.141592/2.5)} ${0.085*sin(1.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(1.*3.141592/2.5)}"/>
<xacro:leg prefix="limb2" shoulderxyz="${0.085*cos(2.*3.141592/2.5)} ${0.085*sin(2.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(2.*3.141592/2.5)}"/>
<xacro:leg prefix="limb3" shoulderxyz="${0.085*cos(3.*3.141592/2.5)} ${0.085*sin(3.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(3.*3.141592/2.5)}"/>
<xacro:leg prefix="limb4" shoulderxyz="${0.085*cos(4.*3.141592/2.5)} ${0.085*sin(4.*3.141592/2.5)} 0." shoulderrpy="0. 0. ${(4.*3.141592/2.5)}"/>

</robot>
